              "id": "417566b2",
              "name": "Move Selection Up / Down",
              "expanded": false,
              "text": "Move Selection Up / Down\n\nSignature: void MoveSelection(int dir)\nMethod: MoveSelection\nReturns: void\nParameters:\n    dir int",
