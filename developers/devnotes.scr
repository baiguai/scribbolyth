          "text": "Help Dialog Class",
          "children": [
          {
            "id": "a5fd3663",
            "name": "Private Members",
            "expanded": false,
            "text": "Private Members",
            "children": [
            {
              "id": "49aa3b3a",
              "name": "Filtered Vector",
              "expanded": false,
              "text": "Filtered Vector\n\nstd::vector<int> Filtered() const\n{\n    std::vector<int> result;\n\n    std::string needle = Lower(filter_);\n    bool key_only = false;\n    if (!needle.empty() && needle[0] == ':')\n    {\n        key_only = true;\n        needle = needle.substr(1);\n    }\n\n    for (std::size_t i = 0; i < entries_.size(); ++i)\n    {\n        const std::string& hay = key_only ? entries_[i].key : entries_[i].line;\n        if (needle.empty() || Lower(hay).find(needle) != std::string::npos)\n        {\n            result.push_back(static_cast<int>(i));\n        }\n    }\n    return result;\n}",
              "children": [
              ]
            },
            {
              "id": "7c8feb87",
              "name": "Max Top Const",
              "expanded": false,
              "text": "Max Top Const\n\nSignature: int MaxTop() const\nMethod: MaxTop\nReturns: int\nQualifiers: const",
              "children": [
              ]
            },
            {
              "id": "69501ccf",
              "name": "Variables",
              "expanded": false,
              "text": "Variables\n\n--------------------------------------------------------------------------------\n\nstd::shared_ptr<EditorState> state_;\nbool* show_;\nstd::vector<HelpEntry> entries_;\nstd::string filter_;\nint scroll_ = 0;\nint content_width_ = 72;\nstatic constexpr int kVisibleRows = 18;",
              "children": [
              ]
            }
            ]
          },
          {
            "id": "75db87a0",
            "name": "Public Members",
            "expanded": false,
            "text": "Public Members",
            "children": [
            {
